# Copy to .env and fill in. Nothing here is required -- without a key the
# pipeline falls back to the deterministic template, so it runs with this file
# absent.

# --- Answer generation (optional) -------------------------------------------
# With a key, retrieved claims are synthesised by Claude.
# Without one, the deterministic template runs instead (counts always exact).
ANTHROPIC_API_KEY=sk-ant-...

# Alternative to the API key: a token from `ant auth login`.
# ANTHROPIC_AUTH_TOKEN=

# --- Retrieval (optional) ---------------------------------------------------
# Higher-rate-limit model downloads from the Hugging Face hub.
# HF_TOKEN=
